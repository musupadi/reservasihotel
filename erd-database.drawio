        <mxCell id="db-info-text" value="Engine: InnoDB&#xa;Charset: utf8mb4&#xa;Collation: utf8mb4_general_ci&#xa;&#xa;Total Tables: 5&#xa;- users&#xa;- hotels (21 records)&#xa;- room_types (42 records)&#xa;- reservations&#xa;- reservation_history&#xa;&#xa;Auto Timestamps: ON&#xa;Foreign Keys: CASCADE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=10;" vertex="1" parent="1">
