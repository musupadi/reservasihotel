          <mxGeometry x="100" y="1160" width="260" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="rules-text" value="1. reservation_id must be unique&#xa;   Format: RES-YYYYMMDD-XXXX&#xa;&#xa;2. guest_count must be between&#xa;   min_capacity and max_capacity&#xa;&#xa;3. check_out &gt; check_in&#xa;&#xa;4. Price calculation:&#xa;   total_price = price_per_person&#xa;                 × guest_count&#xa;&#xa;5. Status flow:&#xa;   PENDING → CONFIRMED →&#xa;   CHECKED_IN → CHECKED_OUT" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="110" y="1190" width="240" height="160" as="geometry"/>
